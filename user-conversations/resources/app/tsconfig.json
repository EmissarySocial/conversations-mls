{
	"compileOnSave": true,

	// Visit https://aka.ms/tsconfig to read more about this file
	"compilerOptions": {
		// File Layout
		"rootDir": "./src",
		"outDir": "./dist",

		// Environment Settings
		// See also https://aka.ms/tsconfig/module
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "es2022",
		"types": [],
		"lib": ["dom", "dom.iterable", "esnext"],

		// Other Outputs
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,

		// Stricter Typechecking Options
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,

		// Style Options
		// "noImplicitReturns": true,
		// "noImplicitOverride": true,
		// "noUnusedLocals": true,
		// "noUnusedParameters": true,
		// "noFallthroughCasesInSwitch": true,
		// "noPropertyAccessFromIndexSignature": true,

		// Recommended Options
		"strict": true,
		"strictNullChecks": true,
		"noImplicitThis": true,
		"noImplicitReturns": true,
		"jsx": "react",
		"jsxFactory": "m",
		"jsxFragmentFactory": "m.Fragment",
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force",

		// Trust dependency declaration files instead of compiling them. This is a
		// browser app that deliberately omits @types/node ("types": [] above), so
		// vite/vitest's .d.ts files reference Node globals (Buffer, node:http, NodeJS.*)
		// that we intentionally do not expose. Separately, @js-temporal/polyfill v0.5.1
		// predates TypeScript's native Temporal lib types and its Intl.DateTimeFormat
		// augmentation cannot satisfy the newer built-in signatures. Neither is fixable
		// in our source; skipLibCheck skips only .d.ts files, so our own code stays
		// fully type-checked against those libraries.
		"skipLibCheck": true,

		"esModuleInterop": true
	},

	// Only the app source under rootDir is part of the build; the test-runner
	// config lives at the project root and is excluded so it does not violate
	// rootDir (it is type-checked by vitest/vite itself, not this program).
	"exclude": ["vitest.config.ts", "dist"]
}
